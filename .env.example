# Port Configuration (Unik & Bebas Tabrakan di VPS)
FRONTEND_PORT=3428
BACKEND_PORT=8428

# AI Provider Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=local-model
LM_STUDIO_API_KEY=lm-studio

AI_DEFAULT_PROVIDER=gemini
WRITING_DEFAULT_PROVIDER=gemini

# Database & Storage Configuration
# For Docker Compose PostgreSQL: postgresql+psycopg://cest:cest_local_pass@db:5432/cest
# For direct host execution fallback: sqlite:///./data/cest.db
DATABASE_URL=sqlite:///./data/cest.db
AUDIO_STORAGE_DIR=./data/audio

# Kosongkan atau gunakan relative URL saat deploy Docker Compose
NEXT_PUBLIC_API_BASE_URL=
